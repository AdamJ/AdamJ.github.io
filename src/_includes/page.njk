---
layout: base.njk
---

<section class="hero{% if motion %} hero-intro{% endif %}" aria-labelledby="hero-heading">
  <h1 id="hero-heading">{{ title }}</h1>
  <p>{{ description }}</p>
  {%- if (headerButton) -%}
  <a href="{{ primaryURL}}" class="btn">{{ primaryAction }}</a>
  {%- else -%}{%- endif -%}
</section>

<content{% if motion %} data-reveal-auto{% endif %}>
  {{ content | safe }}
</content>

{% include "case-study-nav.njk" %}

{% if customCss %}
  <link type="text/css" href="/css/{{ customCss | url }}" rel="stylesheet" />
{% endif %}
